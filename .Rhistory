})
output$spread_summary_table <- renderTable({
spread_summary_full
})
zoomed_summaries <- reactive({
req(input$ts_zoom_range)
rng <- as.Date(input$ts_zoom_range)
monthly_summaries[date >= rng[1] & date <= rng[2]]
})
zoomed_year_boundaries <- reactive({
req(input$ts_zoom_range)
rng <- as.Date(input$ts_zoom_range)
year_boundaries[
year_boundaries >= rng[1] &
year_boundaries <= rng[2]
]
})
output$timeseries_plot <- renderPlot({
monthly_data <- zoomed_summaries()
req(nrow(monthly_data) > 0)
rng <- as.Date(input$ts_zoom_range)
p <- ggplot(monthly_data, aes(x = date)) +
geom_ribbon(
aes(ymin = min_no2, ymax = max_no2),
fill = "grey80",
alpha = 0.5
) +
geom_line(
aes(y = mean_no2),
color = "black",
linewidth = 0.7
) +
geom_vline(
xintercept = as.numeric(zoomed_year_boundaries()),
color = "orange",
linetype = "dashed",
linewidth = 0.5
) +
labs(
title = "Monthly NO\u2082 across selected grid cells",
subtitle = paste(
format(rng[1], "%b %Y"),
"-",
format(rng[2], "%b %Y")
),
x = NULL,
y = "NO\u2082"
) +
theme_minimal()
if (isTRUE(input$show_oldtown)) {
oldtown_zoomed <- oldtown_monthly[
date >= rng[1] & date <= rng[2]
]
if (nrow(oldtown_zoomed) > 0) {
p <- p +
geom_line(
data = oldtown_zoomed,
aes(x = date, y = no2_oldtown),
color = "lightblue",
linewidth = 0.8
)
}
}
if (isTRUE(input$show_essex)) {
essex_zoomed <- essex_monthly[
date >= rng[1] & date <= rng[2]
]
if (nrow(essex_zoomed) > 0) {
p <- p +
geom_line(
data = essex_zoomed,
aes(x = date, y = no2_essex),
color = "red",
linewidth = 0.8
)
}
}
if (selected_date() >= rng[1] && selected_date() <= rng[2]) {
p <- p +
geom_vline(
xintercept = as.numeric(selected_date()),
color = "red",
linewidth = 1
)
}
p
})
output$spread_plot <- renderPlot({
monthly_data <- zoomed_summaries()
req(nrow(monthly_data) > 0)
rng <- as.Date(input$ts_zoom_range)
p <- ggplot(
monthly_data,
aes(x = date, y = spread_no2)
) +
geom_line(color = "darkgreen", linewidth = 0.7) +
geom_vline(
xintercept = as.numeric(zoomed_year_boundaries()),
color = "orange",
linetype = "dashed",
linewidth = 0.5
) +
labs(
title = "Monthly NO\u2082 spread (maximum minus minimum)",
x = "Month",
y = "NO\u2082 spread"
) +
theme_minimal()
if (selected_date() >= rng[1] && selected_date() <= rng[2]) {
p <- p +
geom_vline(
xintercept = as.numeric(selected_date()),
color = "red",
linewidth = 1
)
}
p
})
# Find the raster cell whose center is closest to Oldtown.
oldtown_grid_cell <- reactive({
all_grid_cells <- rbindlist(
lapply(available_years, function(yr) {
load_year_data(yr)[, .(x, y)]
})
)
grid_cells <- unique(all_grid_cells)
grid_cells[, distance_sq :=
(x - oldtown_lon)^2 + (y - oldtown_lat)^2
]
grid_cells[which.min(distance_sq), .(x, y)]
}) |> bindCache(oldtown_lon, oldtown_lat)
# Find the raster cell whose center is closest to Essex.
essex_grid_cell <- reactive({
all_grid_cells <- rbindlist(
lapply(available_years, function(yr) {
load_year_data(yr)[, .(x, y)]
})
)
grid_cells <- unique(all_grid_cells)
grid_cells[, distance_sq :=
(x - essex_lon)^2 + (y - essex_lat)^2
]
grid_cells[which.min(distance_sq), .(x, y)]
}) |> bindCache(essex_lon, essex_lat)
# Build Oldtown comparison data within the selected slider range.
oldtown_comparison_data <- reactive({
req(input$ts_zoom_range)
rng <- as.Date(input$ts_zoom_range)
cell <- oldtown_grid_cell()
all_grid_data <- rbindlist(
lapply(available_years, function(yr) {
load_year_data(yr)[, .(date, x, y, no2)]
})
)
if (input$scatter_comparison == "grid_cell") {
grid_monthly <- all_grid_data[
x == cell$x[1] & y == cell$y[1],
.(
no2_compare = mean(
no2[is.finite(no2) & no2 != 0],
na.rm = TRUE
)
),
by = date
]
comparison_label <- "Oldtown grid cell"
} else {
grid_monthly <- monthly_summaries[
,
.(no2_compare = mean_no2),
by = date
]
comparison_label <- "Mean across grid cells"
}
result <- merge(
oldtown_monthly,
grid_monthly,
by = "date",
all = FALSE
)
result <- result[
date >= rng[1] &
date <= rng[2] &
is.finite(no2_oldtown) &
is.finite(no2_compare)
]
attr(result, "comparison_label") <- comparison_label
result
})
output$scatter_plot <- renderPlotly({
comparison_data <- oldtown_comparison_data()
req(nrow(comparison_data) > 0)
comparison_label <- attr(
comparison_data,
"comparison_label"
)
comparison_data[, tooltip_text := paste0(
format(date, "%B %Y"), "<br>",
"Oldtown: ", signif(no2_oldtown, 4), "<br>",
comparison_label, ": ", signif(no2_compare, 4)
)]
p <- ggplot(
comparison_data,
aes(
x = no2_compare,
y = no2_oldtown,
text = tooltip_text
)
) +
geom_abline(
intercept = 0,
slope = 1,
color = "orange",
linetype = "dashed"
) +
geom_point(
alpha = 0.65,
color = "steelblue",
size = 2
) +
labs(
title = paste("Oldtown vs.", comparison_label),
x = paste(comparison_label, "NO\u2082"),
y = "Oldtown measured NO\u2082",
subtitle = paste0(
"Monthly observations (n = ",
nrow(comparison_data),
")"
)
) +
theme_minimal()
ggplotly(p, tooltip = "text")
})
# Build Essex comparison data within the selected slider range.
essex_comparison_data <- reactive({
req(input$ts_zoom_range)
rng <- as.Date(input$ts_zoom_range)
cell <- essex_grid_cell()
all_grid_data <- rbindlist(
lapply(available_years, function(yr) {
load_year_data(yr)[, .(date, x, y, no2)]
})
)
if (input$essex_scatter_comparison == "grid_cell") {
grid_monthly <- all_grid_data[
x == cell$x[1] & y == cell$y[1],
.(
no2_compare = mean(
no2[is.finite(no2) & no2 != 0],
na.rm = TRUE
)
),
by = date
]
comparison_label <- "Essex grid cell"
} else {
grid_monthly <- monthly_summaries[
,
.(no2_compare = mean_no2),
by = date
]
comparison_label <- "Mean across grid cells"
}
result <- merge(
essex_monthly,
grid_monthly,
by = "date",
all = FALSE
)
result <- result[
date >= rng[1] &
date <= rng[2] &
is.finite(no2_essex) &
is.finite(no2_compare)
]
attr(result, "comparison_label") <- comparison_label
result
})
output$essex_scatter_plot <- renderPlotly({
comparison_data <- essex_comparison_data()
req(nrow(comparison_data) > 0)
comparison_label <- attr(
comparison_data,
"comparison_label"
)
comparison_data[, tooltip_text := paste0(
format(date, "%B %Y"), "<br>",
"Essex: ", signif(no2_essex, 4), "<br>",
comparison_label, ": ", signif(no2_compare, 4)
)]
p <- ggplot(
comparison_data,
aes(
x = no2_compare,
y = no2_essex,
text = tooltip_text
)
) +
geom_abline(
intercept = 0,
slope = 1,
color = "orange",
linetype = "dashed"
) +
geom_point(
alpha = 0.65,
color = "firebrick",
size = 2
) +
labs(
title = paste("Essex vs.", comparison_label),
x = paste(comparison_label, "NO\u2082"),
y = "Essex measured NO\u2082",
subtitle = paste0(
"Monthly observations (n = ",
nrow(comparison_data),
")"
)
) +
theme_minimal()
ggplotly(p, tooltip = "text")
})
}
