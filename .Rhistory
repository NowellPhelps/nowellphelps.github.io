mutate(y_starting_at_zero = y - y_anchor) %>%
mutate(source = "FCM") %>%
dplyr::select(c(times, ids, y_starting_at_zero, source)) %>%
dplyr::rename(id = ids)
y_data_observed <- data_observed %>%
filter(group == "Intervention (slope)",
times >= delta)
y_data_observed_anchor <- y_data_observed %>%
filter(round(times, 6) == delta) %>%
mutate(y_anchor = fitted_fev)
y_data_observed <- left_join(y_data_observed, y_data_observed_anchor %>% dplyr::select(c(id, y_anchor)), by = "id")
y_data_observed <- y_data_observed %>%
mutate(y_starting_at_zero = fitted_fev - y_anchor) %>%
mutate(source = "True (observed) data") %>%
dplyr::select(c(id, times, y_starting_at_zero, source))
data_shift_slope <- rbind(y_shift_slope_df_rf, y_shift_slope_df_xgboost) %>%
rbind(y_data_observed) %>%
rbind(y_shift_slope_df_fcm)
plot_data <- data_shift_slope
