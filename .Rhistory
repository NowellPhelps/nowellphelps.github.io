get_haversine_distance <- function(my_x, my_y, x, y) {
geosphere::distHaversine(
p1 = cbind(my_x, my_y),
p2 = cbind(x, y),
r = 6371000
)
}
my_x = data_raw$x[200];
my_y = data_raw$y[200];
my_visdate = data_raw$visdate[200];
pm25_grid_data = data_grid_pm25;
grid_cell_id_match_df = grid_square_id_match
get_closest_grid_cell <- function(my_x, my_y, my_visdate, pm25_grid_data, grid_cell_id_match_df){
my_x <- rep(my_x, nrow(grid_cell_id_match_df))
my_y <- rep(my_y, nrow(grid_cell_id_match_df))
distances <- get_haversine_distance(my_x, my_y, grid_cell_id_match_df$x, grid_cell_id_match_df$y)
grid_cell_id_match_df$distance <- distances
data_day <- pm25_grid_data %>% filter(date == my_visdate)
grid_cell_id_match_df <- left_join(grid_cell_id_match_df, data_day, by = join_by(x, y, grid_cell_id))
grid_cell_id_match_df <- grid_cell_id_match_df[which(!is.na(grid_cell_id_match_df$pm25)),]
if(length(which(grid_cell_id_match_df$distance == min(grid_cell_id_match_df$distance))) > 1) { stop("More than one haversine distance minimiser found")}
distance_to_cell <- min(grid_cell_id_match_df$distance)
grid_cell_id <- grid_cell_id_match_df$grid_cell_id[which(grid_cell_id_match_df$distance == distance_to_cell)]
return(list(grid_cell_id = grid_cell_id,
distance_to_cell = distance_to_cell))
}
get_closest_grid_cell(my_x = data_raw$x[200],
my_y = data_raw$y[200],
my_visdate = data_raw$visdate[200],
pm25_grid_data = data_grid_pm25,
grid_cell_id_match_df = grid_square_id_match)
closest <- mapply(
get_closest_grid_cell,
my_x = data_raw$x,
my_y = data_raw$y,
my_visdate = data_raw$visdate,
MoreArgs = list(pm25_grid_data = data_grid_pm25,
grid_cell_id_match_df = grid_square_id_match),
SIMPLIFY = FALSE
)
data_raw$closest_grid_cell <- vapply(
closest, `[[`, numeric(1), "grid_cell_id")
data_raw$distance_to_cell <- vapply(
closest, `[[`, numeric(1), "distance_to_cell")
View(data_raw)
