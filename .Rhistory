##### LINK DATA
# Find uniaue grid cell fro each visi
data_grid_pm25$x_y <- paste0(data_grid_pm25$x, data_grid_pm25$y)
length(unique(data_grid_pm25$x_y))
grid_square_id_match <- distinct(data_grid_pm25 %>%
dplyr::select(x, y)) %>%
mutate(grid_cell_id = 1:nrow(.))
data_grid_pm25 <- left_join(data_grid_pm25,grid_square_id_match )
